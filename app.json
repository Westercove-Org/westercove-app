{
  "expo": {
    "name": "westercove-app",
    "slug": "westercove-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/westercove_icon_app.png",
    "scheme": "westercoveapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/westercove_icon_app.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Westercove uses the microphone only when you tap the mic to speak a journal entry. Your words are turned into text on your device; no audio is stored or sent.",
        "NSSpeechRecognitionUsageDescription": "Speech recognition turns what you say into text for your journal entry, on your device. No audio is stored or sent."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/westercove_icon_app.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/westercove_icon_app.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "http://localhost:8081"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/westercove_icon_app.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
