{
  "expo": {
    "name": "Westercove",
    "slug": "westercove-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "westercove",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Westercove uses speech recognition to turn your voice into text you can edit before saving.",
        "NSMicrophoneUsageDescription": "Westercove uses the microphone to transcribe what you speak into a journal entry."
      },
      "bundleIdentifier": "com.anonymous.westercove-app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6EFE6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6EFE6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#151019",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 120
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Westercove uses the microphone to transcribe what you speak into a journal entry.",
          "speechRecognitionPermission": "Westercove uses speech recognition to turn your voice into text you can edit before saving."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
